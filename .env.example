# คัดลอกเป็น .env แล้วแก้ค่า — .env ไม่เข้า git
# บน production ค่าที่ทำเครื่องหมาย (บังคับ) ต้องมี ไม่งั้น process ไม่ขึ้น

NODE_ENV=development
PORT=1338
LOG_LEVEL=debug

# ── ฐานข้อมูล ────────────────────────────────────────────────
# (บังคับบน production) คนละ database กับ sellcenter ที่ใช้ `wallet`
MONGO_URL=mongodb://127.0.0.1:27017
# ชื่อฐานข้อมูลแยกตัวพิมพ์เล็กใหญ่ — packVideo ไม่เท่ากับ packvideo
# ทั้งสองบรรทัดนี้ `npm run setup-mongo` เขียนให้เอง และต้องเป็นฐานข้อมูลเดียวกัน
# ตั้งไม่ตรงกัน = ต่อได้แต่เขียนไม่ได้ ระบบจะเงียบไปเฉยๆ (config.js เตือนให้ตอน boot)
MONGO_DB=packVideo

# ── ที่เก็บคลิป ──────────────────────────────────────────────
# (บังคับบน production) ใน container คือ /data/pack_video ซึ่ง mount จาก HDD 1TB ลูกที่ว่าง
# อย่าชี้ไปที่เดียวกับ FILESTORE_PATH ของระบบเดิม
PACK_VIDEO_PATH=./data/pack_video

# ระดับการใช้ดิสก์ — ถึง STOP แล้วหยุดบันทึก แต่งานแพ็คเดินต่อ
DISK_WARN_PCT=75
DISK_SQUEEZE_PCT=85
DISK_STOP_PCT=90

# เก็บคลิปทั่วไปกี่วัน — คลิปที่ pin ไม่โดนลบ
RETENTION_DAYS=30

# เพดานความยาวคลิป (นาที) — คลิปที่ไม่มีการสแกนปิดจะถูกปิดเป็น timeout เมื่อถึงเวลานี้
# ไม่ใช่ความยาวที่ตั้งใจให้คลิปทั่วไปไปชน คลิปปกติยาวราว 2 นาที
# ตั้งต่ำเกินไปจะไปตัดคลิปที่แพ็คนานตามปกติทิ้ง — ห้ามต่ำกว่า 5
CLIP_MAX_MINUTES=15

# ── โต๊ะแพ็ค ────────────────────────────────────────────────
# ตั้ง STATIONS เป็นรายชื่อคั่นจุลภาคถ้าอยากตั้งชื่อเอง
# ไม่ตั้งจะสร้างเป็น desk-01 … ตามจำนวนใน STATION_COUNT
# STATIONS=desk-01,desk-02,desk-03,desk-04,desk-05,desk-06
STATION_COUNT=6

# ── ระบบเดิม ────────────────────────────────────────────────
# (บังคับบน production) origin ของ sellcenter คั่นด้วยจุลภาค ห้ามใช้ *
#
# ค่านี้เป็นแหล่งความจริงเดียวของทั้งสามอย่าง แก้ที่นี่ที่เดียวแล้วรีสตาร์ท:
#   1. origin ที่ยิงสัญญาณเข้า /signal ได้
#   2. origin ที่เรียก GET /api/stations ข้าม origin ได้
#   3. origin ที่ /bridge.html ยอมส่ง station_id/token ให้ และฝัง iframe ได้
ALLOWED_ORIGINS=https://digital.in.th

# ── แจ้งเตือน ───────────────────────────────────────────────
# ห้าม hardcode ลงซอร์สเด็ดขาด
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
