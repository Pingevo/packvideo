# คัดลอกเป็น .env แล้วแก้ค่า — .env ไม่เข้า git
# บน production ค่าที่ทำเครื่องหมาย (บังคับ) ต้องมี ไม่งั้น process ไม่ขึ้น

NODE_ENV=development
PORT=1338
LOG_LEVEL=debug

# ── ฐานข้อมูล ────────────────────────────────────────────────
# (บังคับบน production) คนละ database กับ sellcenter ที่ใช้ `wallet`
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=packvideo

# ── ที่เก็บคลิป ──────────────────────────────────────────────
# (บังคับบน production) ใน container คือ /data/pack_video ซึ่ง mount จาก HDD 1TB ลูกที่ว่าง
# อย่าชี้ไปที่เดียวกับ FILESTORE_PATH ของระบบเดิม
PACK_VIDEO_PATH=./data/pack_video

# ระดับการใช้ดิสก์ — ถึง STOP แล้วหยุดบันทึก แต่งานแพ็คเดินต่อ
DISK_WARN_PCT=75
DISK_SQUEEZE_PCT=85
DISK_STOP_PCT=90

# เก็บคลิปทั่วไปกี่วัน — คลิปที่ pin ไม่โดนลบ
RETENTION_DAYS=30

# ── ระบบเดิม ────────────────────────────────────────────────
# (บังคับบน production) origin ที่อนุญาตให้ยิงสัญญาณเข้ามา คั่นด้วยจุลภาค ห้ามใช้ *
ALLOWED_ORIGINS=https://digital.in.th

# ── แจ้งเตือน ───────────────────────────────────────────────
# ห้าม hardcode ลงซอร์สเด็ดขาด
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
